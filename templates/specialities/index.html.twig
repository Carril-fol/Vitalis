{% extends 'base.html.twig' %}

{% block title %}Especialidades · Vitalis{% endblock %}

{% block body %}
    <div class="container-fluid px-0">

        {% include '_components/_page_header.html.twig' with {
            title: 'Especialidades',
            subtitle: 'Cada profesional se asocia a una especialidad, y los pacientes la usan para elegir con quién sacar turno.',
            actions: [{path: path('specialities.create'), label: 'Nueva especialidad', icon: 'bi-plus-lg', permission: 'create_specialities'}]
        } %}

        {% if specialities is empty %}

            {% include '_components/_empty_state.html.twig' with {
                icon: 'bi-clipboard2-pulse',
                title: 'Todavía no hay especialidades',
                text: 'Creá la primera para poder asignarla a los profesionales.',
                action: {path: path('specialities.create'), label: 'Crear la primera', permission: 'create_specialities'},
                denied_text: 'Espera a que un administrador con permisos para crear especialidades lo haga.'
            } %}

        {% else %}

            <div class="card">
                <div class="card-header py-3">
                    <h2 class="h6 mb-1">Listado de especialidades</h2>
                    <p class="vitalis-hint mb-0">
                        {{ specialities|length == 1 ? '1 especialidad registrada' : specialities|length ~ ' especialidades registradas' }}
                    </p>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4 w-100">Nombre</th>
                                {% if is_granted('update_specialities') or is_granted('delete_specialities') %}
                                    <th class="text-end pe-4 text-nowrap">Acciones</th>
                                {% endif %}
                            </tr>
                        </thead>
                        <tbody>
                            {% for speciality in specialities %}
                                <tr>
                                    <td class="ps-4 fw-semibold">{{ speciality.name }}</td>
                                    <td class="text-end pe-4">
                                        <div class="d-inline-flex gap-2">
                                            {% if is_granted('update_specialities') %}
                                                <a
                                                    class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1"
                                                    href="{{ path('specialities.edit', {id: speciality.id}) }}"
                                                    aria-label="Editar especialidad {{ speciality.name }}"
                                                >
                                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                                    <span class="d-none d-sm-inline">Editar</span>
                                                </a>
                                            {% endif %}

                                            {% if is_granted('delete_specialities') %}
                                                <form
                                                    method="post"
                                                    class="d-inline"
                                                    action="{{ path('specialities.delete', {id: speciality.id}) }}"
                                                    data-turbo-confirm="{{ 'Se va a borrar la especialidad \"' ~ speciality.name ~ '\". Esta acción no se puede deshacer.' }}"
                                                >
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-speciality-' ~ speciality.id) }}">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1" aria-label="Borrar especialidad {{ speciality.name }}">
                                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                                        <span class="d-none d-sm-inline">Borrar</span>
                                                    </button>
                                                </form>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

        {% endif %}
    </div>
{% endblock %}
