{% form_theme form 'bootstrap_5_layout.html.twig' %}

{{ form_start(form, {attr: {novalidate: 'novalidate', 'data-vitalis-loading': true}}) }}

<div class="card">
    <div class="card-header d-flex align-items-center gap-3 py-3">
        <span class="vitalis-card-icon">
            <i class="bi bi-clipboard2-pulse" aria-hidden="true"></i>
        </span>
        <h2 class="h6 mb-0">Información de la especialidad</h2>
    </div>

    <div class="card-body">
        {{ form_row(form.name, {
            attr: {placeholder: 'Ej. Cardiología', maxlength: 50, autofocus: not is_edit, autocomplete: 'off'},
            help: 'Usá el nombre con el que los pacientes van a reconocer la especialidad. Hasta 50 caracteres.'
        }) }}

        {% include '_components/_form_actions.html.twig' with {cancel_path: path('specialities.index')} %}
    </div>
</div>

{{ form_end(form) }}
