{% extends 'base.html.twig' %}

{% block title %}Editar especialidad · Vitalis{% endblock %}

{% block body %}
    <div class="container-fluid px-0">
        {% include '_components/_page_header.html.twig' with {
            title: 'Editar especialidad',
            subtitle: 'El cambio de nombre se refleja en todos los profesionales que la tienen.',
            actions: [{path: path('specialities.index'), label: 'Volver a especialidades', icon: 'bi-arrow-left', class: 'btn btn-link px-0'}]
        } %}

        {% include '_components/_form_errors.html.twig' with {
            title: 'No se pudo guardar la especialidad',
            text: 'Revisá el campo marcado en el formulario.'
        } %}

        <div class="row">
            <div class="col-12 col-xl-8">
                {% include 'specialities/_form.html.twig' with {
                    is_edit: true,
                    submit_label: 'Guardar cambios',
                    loading_label: 'Guardando…'
                } %}
            </div>
        </div>
    </div>
{% endblock %}
