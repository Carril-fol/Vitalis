{% extends 'base.html.twig' %}

{% block title %}Nueva especialidad · Vitalis{% endblock %}

{% block body %}
    <div class="container-fluid px-0">
        {% include '_components/_page_header.html.twig' with {
            title: 'Nueva especialidad',
            subtitle: 'Cada profesional se asocia a una especialidad, y los pacientes la usan para elegir con quién sacar turno.',
            actions: [{path: path('specialities.index'), label: 'Volver a especialidades', icon: 'bi-arrow-left', class: 'btn btn-link px-0'}]
        } %}

        {% include '_components/_form_errors.html.twig' with {
            title: 'No se pudo crear la especialidad',
            text: 'Revisá el campo marcado en el formulario.'
        } %}

        <div class="row">
            <div class="col-12 col-xl-8">
                {% include 'specialities/_form.html.twig' with {
                    is_edit: false,
                    submit_label: 'Crear especialidad',
                    loading_label: 'Creando…'
                } %}
            </div>
        </div>
    </div>
{% endblock %}
