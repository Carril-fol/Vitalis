{% extends 'base.html.twig' %}

{% block title %}Centro Clinico Vitalis - Nueva especialidad{% endblock %}

{% block body %}
<div class="container-fluid px-0">
    <!-- Encabezado de página -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
        <div>
            <h1 class="h3 mb-2">Nueva especialidad</h1>
            <p class="vitalis-hint mb-0">
                Cada profesional se asocia a una especialidad, y los pacientes la usan para elegir con quién sacar turno.
            </p>
        </div>

        <a class="btn btn-link d-inline-flex align-items-center gap-2 flex-shrink-0 px-0" href="{{ path('specialities.index') }}">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            Volver a especialidades
        </a>
    </div>

    {% if error is not null %}
        <!-- Estado de error -->
        <div class="alert alert-danger d-flex align-items-start gap-2 mb-4" role="alert" id="especialidad-error">
            <i class="bi bi-exclamation-circle-fill mt-1 flex-shrink-0" aria-hidden="true"></i>
            <div>
                <strong class="d-block">No se pudo crear la especialidad</strong>
                {{ error }}
            </div>
        </div>
    {% endif %}

    <!-- Formulario -->
    <div class="row">
        <div class="col-12 col-xl-8">
            <div class="card">

                <div class="card-header d-flex align-items-center gap-3 py-3">
                    <span class="vitalis-brand-mark">
                        <i class="bi bi-clipboard2-pulse" aria-hidden="true"></i>
                    </span>
                    <h2 class="h6 mb-0">Información de la especialidad</h2>
                </div>

                <div class="card-body">
                    <form method="post" action="{{ path('specialities.create') }}" data-vitalis-loading>
                        <div class="vitalis-field{{ error is not null ? ' has-error' }}">

                            <label for="name" class="form-label">Nombre de la especialidad</label>

                            <div class="input-group">
                                <span class="input-group-text">
                                    <i class="bi bi-heart-pulse" aria-hidden="true"></i>
                                </span>

                                <input
                                    type="text"
                                    id="name"
                                    name="name"
                                    maxlength="50"
                                    required
                                    autofocus
                                    autocomplete="off"
                                    class="form-control"
                                    value="{{ old.name }}"
                                    placeholder="Ej. Cardiología"
                                    aria-describedby="name-hint{{ error is not null ? ' especialidad-error' }}"
                                    {% if error is not null %}aria-invalid="true"{% endif %}
                                >
                            </div>

                            <p class="vitalis-hint mt-2 mb-0" id="name-hint">
                                Usá el nombre con el que los pacientes van a reconocer la especialidad. Hasta 50 caracteres.
                            </p>

                        </div>

                        <div class="d-grid d-sm-flex justify-content-sm-end gap-2 mt-4">

                            <a class="btn btn-link order-2 order-sm-1" href="{{ path('specialities.index') }}">
                                Cancelar
                            </a>

                            <button
                                type="submit"
                                class="btn btn-primary order-1 order-sm-2 d-inline-flex align-items-center justify-content-center gap-2"
                                data-loading-label="Creando…"
                            >
                                <span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span>
                                <span class="label">Crear especialidad</span>
                            </button>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% set error = errors.name[0] ?? null %}