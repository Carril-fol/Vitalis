{% extends 'base.html.twig' %}

{% block title %}Pacientes · Vitalis{% endblock %}

{% block body %}
    <div class="container-fluid px-0">

        {% include '_components/_page_header.html.twig' with {
            title: 'Pacientes',
            subtitle: 'Los pacientes del centro con su obra social y número de socio.',
            actions: [{path: path('patients.create'), label: 'Nuevo paciente', icon: 'bi-plus-lg', permission: 'create_patients'}]
        } %}

        {% if patients is empty %}

            {% include '_components/_empty_state.html.twig' with {
                icon: 'bi-person-heart',
                title: 'Todavía no hay pacientes',
                text: 'Registrá el primer paciente con sus datos y su obra social.',
                action: {path: path('patients.create'), label: 'Nuevo paciente', permission: 'create_patients'},
                denied_text: 'Esperá a que alguien con permiso para registrar pacientes lo haga.'
            } %}

        {% else %}

            <div class="card">
                <div class="card-header py-3">
                    <h2 class="h6 mb-1">Listado de pacientes</h2>
                    <p class="vitalis-hint mb-0">
                        {{ patients|length == 1 ? '1 paciente registrado' : patients|length ~ ' pacientes registrados' }}
                    </p>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Paciente</th>
                                <th class="text-nowrap">Obra social</th>
                                <th class="w-100">Número de socio</th>
                                <th class="text-nowrap">Estado</th>
                                {% if is_granted('update_patients') %}
                                    <th class="text-end pe-4 text-nowrap">Acciones</th>
                                {% endif %}
                            </tr>
                        </thead>
                        <tbody>
                            {% for patient in patients %}
                                {% set user = patient.user %}
                                {% set active = user.isActive %}
                                {% set confirmar = active
                                    ? 'Se va a dar de baja a "' ~ user.fullName ~ '". Sus datos se conservan y se puede reactivar.'
                                    : 'Se va a reactivar a "' ~ user.fullName ~ '".' %}

                                <tr>
                                    <td class="ps-4">
                                        <span class="fw-semibold d-block">{{ user.fullName }}</span>
                                        <span class="vitalis-hint">DNI {{ user.dni }}</span>
                                    </td>

                                    <td class="text-nowrap">{{ patient.healthInsurance.name }}</td>

                                    <td>
                                        {% if patient.memberNumber is empty %}
                                            <span class="vitalis-hint">—</span>
                                        {% else %}
                                            {{ patient.memberNumber }}
                                        {% endif %}
                                    </td>

                                    <td class="text-nowrap">
                                        {% include '_components/_status_badge.html.twig' with {active: active} %}
                                    </td>

                                    {% if is_granted('update_patients') %}
                                        <td class="text-end pe-4">
                                            <div class="d-inline-flex gap-2">

                                                <a
                                                    class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1"
                                                    href="{{ path('patients.edit', {id: patient.id}) }}"
                                                    aria-label="Editar a {{ user.fullName }}"
                                                >
                                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                                    <span class="d-none d-sm-inline">Editar</span>
                                                </a>

                                                <form
                                                    method="post"
                                                    class="d-inline"
                                                    action="{{ path('patients.status', {id : patient.id, status : active ? 'deactivate' : 'activate'}) }}"
                                                    onsubmit="return confirm({{ confirmar|json_encode }});"
                                                >
                                                    <input type="hidden" name="_token" value="{{ csrf_token('status-patient-' ~ patient.id) }}">

                                                    {% if active %}
                                                        <button type="submit" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1" aria-label="Dar de baja a {{ user.fullName }}">
                                                            <i class="bi bi-person-dash" aria-hidden="true"></i>
                                                            <span class="d-none d-sm-inline">Dar de baja</span>
                                                        </button>
                                                    {% else %}
                                                        <button type="submit" class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-1" aria-label="Reactivar a {{ user.fullName }}">
                                                            <i class="bi bi-person-check" aria-hidden="true"></i>
                                                            <span class="d-none d-sm-inline">Reactivar</span>
                                                        </button>
                                                    {% endif %}
                                                </form>

                                            </div>
                                        </td>
                                    {% endif %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

        {% endif %}
    </div>
{% endblock %}
