{% extends 'base.html.twig' %}

{% block title %}Nuevo paciente · Vitalis{% endblock %}

{% block body %}
    <div class="container-fluid px-0">
        {% include '_components/_page_header.html.twig' with {
            title: 'Nuevo paciente',
            subtitle: 'Se crean la persona y su ficha de paciente en un solo paso.',
            actions: [{path: path('patients.index'), label: 'Volver a pacientes', icon: 'bi-arrow-left', class: 'btn btn-link px-0'}]
        } %}

        {% include '_components/_form_errors.html.twig' with {title: 'No se pudo crear el paciente'} %}

        <div class="row">
            <div class="col-12 col-xl-8">
                {% include 'patients/_form.html.twig' with {
                    is_edit: false,
                    submit_label: 'Crear paciente',
                    loading_label: 'Creando…'
                } %}
            </div>
        </div>
    </div>
{% endblock %}
