{% set actions = actions|default([]) %}

<div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
    <div>
        <h1 class="h3 mb-2">{{ title }}</h1>
        {% if subtitle is defined and subtitle %}
            <p class="vitalis-hint mb-0">{{ subtitle }}</p>
        {% endif %}
    </div>

    {% if actions %}
        <div class="d-flex flex-wrap gap-2 flex-shrink-0">
            {% for action in actions %}
                {% if action.permission is not defined or is_granted(action.permission) %}
                    <a class="{{ action.class|default('btn btn-primary') }} d-inline-flex align-items-center gap-2" href="{{ action.path }}">
                        {% if action.icon is defined %}<i class="bi {{ action.icon }}" aria-hidden="true"></i>{% endif %}
                        {{ action.label }}
                    </a>
                {% endif %}
            {% endfor %}
        </div>
    {% endif %}
</div>
