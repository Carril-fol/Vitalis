{% extends 'base.html.twig' %}

{% block title %}Editar rol · Vitalis{% endblock %}

{% block body %}
    {% set role = form.vars.value %}

    <div class="container-fluid px-0">
        {% include '_components/_page_header.html.twig' with {
            title: 'Editar rol',
            subtitle: role.name ~ (role.area is not null ? ' · ' ~ role.area.label : ''),
            actions: [{path: path('roles.index'), label: 'Volver a roles', icon: 'bi-arrow-left', class: 'btn btn-link px-0'}]
        } %}

        {% include '_components/_form_errors.html.twig' with {title: 'No se pudo guardar el rol'} %}

        <div class="row">
            <div class="col-12 col-xl-8">
                {% include 'roles/_form.html.twig' with {
                    is_edit: true,
                    submit_label: 'Guardar cambios',
                    loading_label: 'Guardando…'
                } %}
            </div>
        </div>
    </div>
{% endblock %}
