{% extends 'base.html.twig' %}

{% block title %}Roles · Vitalis{% endblock %}

{% block body %}
    <div class="container-fluid px-0">

        {% include '_components/_page_header.html.twig' with {
            title: 'Roles',
            subtitle: 'Los roles agrupan los permisos que después asignás a cada usuario.',
            actions: [{path: path('roles.create'), label: 'Nuevo rol', icon: 'bi-plus-lg', permission: 'create_roles'}]
        } %}

        {% if roles is empty %}

            {% include '_components/_empty_state.html.twig' with {
                icon: 'bi-person-fill-gear',
                title: 'Todavía no hay roles',
                text: 'Creá el primero para empezar a repartir permisos entre los usuarios.',
                action: {path: path('roles.create'), label: 'Crear el primer rol', permission: 'create_roles'},
                denied_text: 'Espera a que un administrador con permisos para crear roles lo haga.'
            } %}

        {% else %}

            <div class="card">
                <div class="card-header py-3">
                    <h2 class="h6 mb-1">Listado de roles</h2>
                    <p class="vitalis-hint mb-0">
                        {{ roles|length == 1 ? '1 rol registrado' : roles|length ~ ' roles registrados' }}
                    </p>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4 w-100">Nombre</th>
                                <th class="text-nowrap">Área</th>
                                {% if is_granted('update_roles') or is_granted('delete_roles') %}
                                    <th class="text-end pe-4 text-nowrap">Acciones</th>
                                {% endif %}
                            </tr>
                        </thead>
                        <tbody>
                            {% for role in roles %}
                                <tr>
                                    <td class="ps-4 fw-semibold">{{ role.name }}</td>
                                    <td class="text-nowrap">
                                        {% if role.area is null %}
                                            <span class="vitalis-hint">—</span>
                                        {% else %}
                                            {{ role.area.label }}
                                        {% endif %}
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="d-inline-flex gap-2">
                                            {% if is_granted('update_roles') %}
                                                <a
                                                    class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1"
                                                    href="{{ path('roles.edit', {id: role.id}) }}"
                                                    aria-label="Editar rol {{ role.name }}"
                                                >
                                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                                    <span class="d-none d-sm-inline">Editar</span>
                                                </a>
                                            {% endif %}

                                            {% if is_granted('delete_roles') %}
                                                <form
                                                    method="post"
                                                    class="d-inline"
                                                    action="{{ path('roles.delete', {id: role.id}) }}"
                                                    onsubmit="return confirm({{ ('Se va a borrar el rol \"' ~ role.name ~ '\". Esta acción no se puede deshacer.')|json_encode }});"
                                                >
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-role-' ~ role.id) }}">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1" aria-label="Borrar rol {{ role.name }}">
                                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                                        <span class="d-none d-sm-inline">Borrar</span>
                                                    </button>
                                                </form>
                                            {% endif %}
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

        {% endif %}
    </div>
{% endblock %}
