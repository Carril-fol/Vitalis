{% extends 'base.html.twig' %}

{% block title %}Nuevo rol · Vitalis{% endblock %}

{% block body %}
    <div class="container-fluid px-0">
        {% include '_components/_page_header.html.twig' with {
            title: 'Nuevo rol',
            subtitle: 'Los roles agrupan los permisos que después asignás a cada usuario.',
            actions: [{path: path('roles.index'), label: 'Volver a roles', icon: 'bi-arrow-left', class: 'btn btn-link px-0'}]
        } %}

        {% include '_components/_form_errors.html.twig' with {title: 'No se pudo crear el rol'} %}

        <div class="row">
            <div class="col-12 col-xl-8">
                {% include 'roles/_form.html.twig' with {
                    is_edit: false,
                    submit_label: 'Crear rol',
                    loading_label: 'Creando…'
                } %}
            </div>
        </div>
    </div>
{% endblock %}
