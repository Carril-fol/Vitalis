{% extends 'base.html.twig' %}

{% block title %}Centro Clinico Vitalis - Nuevo rol{% endblock %}

{% block body %}
    {% set error = errors is empty ? null : (errors|first)|first %}
    <div class="container-fluid px-0">
        <!-- Encabezado de página -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
            <div>
                <h1 class="h3 mb-2">Nuevo rol</h1>
                <p class="vitalis-hint mb-0">
                    Los roles agrupan los permisos que después asignás a cada usuario.
                </p>
            </div>

            <a class="btn btn-link d-inline-flex align-items-center gap-2 flex-shrink-0 px-0" href="{{ path('roles.index') }}">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                Volver a roles
            </a>
        </div>

        {% if error is not null %}
            <!-- Estado de error -->
            <div class="alert alert-danger d-flex align-items-start gap-2 mb-4" role="alert" id="rol-error">
                <i class="bi bi-exclamation-circle-fill mt-1 flex-shrink-0" aria-hidden="true"></i>
                <div>
                    <strong class="d-block">No se pudo crear el rol</strong>
                    {{ error }}
                </div>
            </div>
        {% endif %}

        <!-- Formulario -->
        <div class="row">
            <div class="col-12 col-xl-8">
                <div class="card">

                    <div class="card-header d-flex align-items-center gap-3 py-3">
                        <span class="vitalis-brand-mark">
                            <i class="bi bi-shield-plus" aria-hidden="true"></i>
                        </span>
                        <h2 class="h6 mb-0">Información del rol</h2>
                    </div>

                    <div class="card-body">
                        <form method="post" action="{{ path('roles.create') }}" data-vitalis-loading>
                            <div class="vitalis-field{{ errors.name is defined ? ' has-error' }}">
                                <label for="name" class="form-label">Nombre del rol</label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-shield-lock" aria-hidden="true"></i>
                                    </span>

                                    <input
                                        type="text"
                                        id="name"
                                        name="name"
                                        maxlength="50"
                                        required
                                        autofocus
                                        autocomplete="off"
                                        class="form-control"
                                        value="{{ old.name }}"
                                        placeholder="Ej. Recepción"
                                        aria-describedby="name-hint{{ errors.name is defined ? ' rol-error' }}"
                                        {% if errors.name is defined %}aria-invalid="true"{% endif %}
                                    >
                                </div>

                                <p class="vitalis-hint mt-2 mb-0" id="name-hint">
                                    Usá el nombre con el que el equipo va a reconocer al rol. Hasta 50 caracteres.
                                </p>
                            </div>

                            <div class="vitalis-field mt-4">
                                <label for="area" class="form-label">Área</label>
                                <select id="area" name="area" class="form-select" aria-describedby="area-hint">
                                    <option value="">Sin área</option>
                                    {% for area in areas %}
                                        <option value="{{ area.value }}" {{ old.area == area.value ? 'selected' }}>{{ area.label }}</option>
                                    {% endfor %}
                                </select>
                                <p class="vitalis-hint mt-2 mb-0" id="area-hint">
                                    El alta de cada perfil ofrece solo los roles de su área (por ejemplo, el puesto de un administrativo). Un rol sin área sirve igual para permisos.
                                </p>
                            </div>

                            {% include 'roles/_permissions.html.twig' %}

                            <div class="d-grid d-sm-flex justify-content-sm-end gap-2 mt-4">

                                <a class="btn btn-link order-2 order-sm-1" href="{{ path('roles.index') }}">
                                    Cancelar
                                </a>

                                <button
                                    type="submit"
                                    class="btn btn-primary order-1 order-sm-2 d-inline-flex align-items-center justify-content-center gap-2"
                                    data-loading-label="Creando…"
                                >
                                    <span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span>
                                    <span class="label">Crear rol</span>
                                </button>

                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
