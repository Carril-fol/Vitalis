{% extends 'base.html.twig' %}

{% block title %}Nuevo administrativo · Vitalis{% endblock %}

{% block body %}
    <div class="container-fluid px-0">
        {% include '_components/_page_header.html.twig' with {
            title: 'Nuevo administrativo',
            subtitle: 'Se crean la persona y su legajo en un solo paso.',
            actions: [{path: path('administratives.index'), label: 'Volver a administrativos', icon: 'bi-arrow-left', class: 'btn btn-link px-0'}]
        } %}

        {% include '_components/_form_errors.html.twig' with {title: 'No se pudo crear el administrativo'} %}

        <div class="row">
            <div class="col-12 col-xl-8">
                {% include 'administratives/_form.html.twig' with {
                    is_edit: false,
                    submit_label: 'Crear administrativo',
                    loading_label: 'Creando…'
                } %}
            </div>
        </div>
    </div>
{% endblock %}
