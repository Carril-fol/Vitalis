{% extends 'base.html.twig' %}

{% block title %}Centro Clinico Vitalis - Nuevo administrativo{% endblock %}

{#
    errors viene de ValidationException: nombre de la propiedad del schema
    (firstName) => mensajes. old es el POST tal cual, con los nombres de los
    campos (first_name) y sin la contraseña.
#}
{% block body %}
<div class="container-fluid px-0">
    <!-- Encabezado de página -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
        <div>
            <h1 class="h3 mb-2">Nuevo administrativo</h1>
            <p class="vitalis-hint mb-0">
                Se crean la persona y su legajo en un solo paso. El rol lo asigna el sistema.
            </p>
        </div>

        <a class="btn btn-link d-inline-flex align-items-center gap-2 flex-shrink-0 px-0" href="{{ path('administratives.index') }}">
            <i class="bi bi-arrow-left" aria-hidden="true"></i>
            Volver a administrativos
        </a>
    </div>

    {% if errors is not empty %}
        <!-- Resumen. El detalle va debajo de cada campo. -->
        <div class="alert alert-danger d-flex align-items-start gap-2 mb-4" role="alert">
            <i class="bi bi-exclamation-circle-fill mt-1 flex-shrink-0" aria-hidden="true"></i>
            <div>
                <strong class="d-block">No se pudo crear el administrativo</strong>
                {{ errors|length == 1 ? 'Revisá el campo marcado.' : 'Revisá los ' ~ errors|length ~ ' campos marcados.' }}
            </div>
        </div>
    {% endif %}

    <div class="row">
        <div class="col-12 col-xl-8">
            <form method="post" action="{{ path('administratives.create') }}" novalidate data-vitalis-loading>

                <div class="card mb-4">
                    <div class="card-header d-flex align-items-center gap-3 py-3">
                        <span class="vitalis-brand-mark">
                            <i class="bi bi-person-plus" aria-hidden="true"></i>
                        </span>
                        <h2 class="h6 mb-0">Datos de la persona</h2>
                    </div>

                    <div class="card-body">
                        <div class="row g-3">

                            <div class="col-12 col-sm-6">
                                <label for="first_name" class="form-label">Nombre</label>
                                <input
                                    type="text" id="first_name" name="first_name" maxlength="100"
                                    autocomplete="off" class="form-control{{ errors.firstName is defined ? ' is-invalid' }}"
                                    value="{{ old.first_name ?? '' }}" placeholder="Ej. Ana"
                                >
                                {% if errors.firstName is defined %}
                                    <div class="invalid-feedback">{{ errors.firstName[0] }}</div>
                                {% endif %}
                            </div>

                            <div class="col-12 col-sm-6">
                                <label for="last_name" class="form-label">Apellido</label>
                                <input
                                    type="text" id="last_name" name="last_name" maxlength="100"
                                    autocomplete="off" class="form-control{{ errors.lastName is defined ? ' is-invalid' }}"
                                    value="{{ old.last_name ?? '' }}" placeholder="Ej. Gómez"
                                >
                                {% if errors.lastName is defined %}
                                    <div class="invalid-feedback">{{ errors.lastName[0] }}</div>
                                {% endif %}
                            </div>

                            <div class="col-12 col-sm-6">
                                <label for="dni" class="form-label">DNI</label>
                                <input
                                    type="text" id="dni" name="dni" maxlength="8" inputmode="numeric"
                                    autocomplete="off" class="form-control{{ errors.dni is defined ? ' is-invalid' }}"
                                    value="{{ old.dni ?? '' }}" placeholder="Sin puntos"
                                >
                                {% if errors.dni is defined %}
                                    <div class="invalid-feedback">{{ errors.dni[0] }}</div>
                                {% endif %}
                            </div>

                            <div class="col-12 col-sm-6">
                                <label for="birth_date" class="form-label">Fecha de nacimiento</label>
                                <input
                                    type="date" id="birth_date" name="birth_date"
                                    class="form-control{{ errors.birthDate is defined ? ' is-invalid' }}"
                                    value="{{ old.birth_date ?? '' }}"
                                >
                                {% if errors.birthDate is defined %}
                                    <div class="invalid-feedback">{{ errors.birthDate[0] }}</div>
                                {% endif %}
                            </div>

                            <div class="col-12 col-sm-6">
                                <label for="email" class="form-label">Email</label>
                                <input
                                    type="email" id="email" name="email" maxlength="150"
                                    autocomplete="off" class="form-control{{ errors.email is defined ? ' is-invalid' }}"
                                    value="{{ old.email ?? '' }}" placeholder="nombre@clinica.local"
                                >
                                {% if errors.email is defined %}
                                    <div class="invalid-feedback">{{ errors.email[0] }}</div>
                                {% endif %}
                            </div>

                            <div class="col-12 col-sm-6">
                                <label for="password" class="form-label">Contraseña inicial</label>
                                <input
                                    type="password" id="password" name="password"
                                    autocomplete="new-password" class="form-control{{ errors.password is defined ? ' is-invalid' }}"
                                >
                                {% if errors.password is defined %}
                                    <div class="invalid-feedback">{{ errors.password[0] }}</div>
                                {% else %}
                                    <div class="form-text">La persona la cambia en su primer ingreso.</div>
                                {% endif %}
                            </div>

                            <div class="col-12">
                                <hr class="my-2">
                                <p class="vitalis-hint mb-0">Datos de contacto (opcionales)</p>
                            </div>

                            <div class="col-12 col-sm-6">
                                <label for="phone" class="form-label">Teléfono</label>
                                <input
                                    type="tel" id="phone" name="phone" maxlength="30"
                                    autocomplete="off" class="form-control{{ errors.phone is defined ? ' is-invalid' }}"
                                    value="{{ old.phone ?? '' }}" placeholder="Ej. 11 5555-5555"
                                >
                                {% if errors.phone is defined %}
                                    <div class="invalid-feedback">{{ errors.phone[0] }}</div>
                                {% endif %}
                            </div>

                            <div class="col-12 col-sm-6">
                                <label for="city" class="form-label">Ciudad</label>
                                <input
                                    type="text" id="city" name="city" maxlength="100"
                                    autocomplete="off" class="form-control{{ errors.city is defined ? ' is-invalid' }}"
                                    value="{{ old.city ?? '' }}" placeholder="Ej. Rosario"
                                >
                                {% if errors.city is defined %}
                                    <div class="invalid-feedback">{{ errors.city[0] }}</div>
                                {% endif %}
                            </div>

                            <div class="col-12">
                                <label for="address" class="form-label">Dirección</label>
                                <input
                                    type="text" id="address" name="address" maxlength="150"
                                    autocomplete="off" class="form-control{{ errors.address is defined ? ' is-invalid' }}"
                                    value="{{ old.address ?? '' }}" placeholder="Ej. San Martín 1234"
                                >
                                {% if errors.address is defined %}
                                    <div class="invalid-feedback">{{ errors.address[0] }}</div>
                                {% endif %}
                            </div>

                        </div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header d-flex align-items-center gap-3 py-3">
                        <span class="vitalis-brand-mark">
                            <i class="bi bi-person-badge" aria-hidden="true"></i>
                        </span>
                        <h2 class="h6 mb-0">Legajo</h2>
                    </div>

                    <div class="card-body">
                        <div class="row g-3">

                            <div class="col-12 col-sm-6">
                                <label for="sector" class="form-label">Sector</label>
                                <input
                                    type="text" id="sector" name="sector" maxlength="100"
                                    autocomplete="off" class="form-control{{ errors.sector is defined ? ' is-invalid' }}"
                                    value="{{ old.sector ?? '' }}" placeholder="Ej. Mesa de entradas"
                                >
                                {% if errors.sector is defined %}
                                    <div class="invalid-feedback">{{ errors.sector[0] }}</div>
                                {% endif %}
                            </div>

                            <div class="col-12 col-sm-6">
                                <label for="role_id" class="form-label">Puesto</label>
                                <select
                                    id="role_id" name="role_id"
                                    class="form-select{{ errors.roleId is defined ? ' is-invalid' }}"
                                    {{ positions is empty ? 'disabled' }}
                                >
                                    <option value="">Elegí un puesto</option>
                                    {% for role in positions %}
                                        <option value="{{ role.id }}" {{ (old.role_id ?? '') == role.id ? 'selected' }}>{{ role.name }}</option>
                                    {% endfor %}
                                </select>
                                {% if errors.roleId is defined %}
                                    <div class="invalid-feedback">{{ errors.roleId[0] }}</div>
                                {% elseif positions is empty %}
                                    <div class="form-text">
                                        No hay roles del área administrativa.
                                        <a href="{{ path('roles.create') }}">Creá uno</a> para poder elegirlo como puesto.
                                    </div>
                                {% else %}
                                    <div class="form-text">Es el rol de la persona: define sus permisos.</div>
                                {% endif %}
                            </div>

                            <div class="col-12">
                                <label for="notes" class="form-label">
                                    Notas <span class="vitalis-hint">(opcional)</span>
                                </label>
                                <textarea
                                    id="notes" name="notes" rows="3" class="form-control"
                                    placeholder="Ej. Turno mañana, cubre guardias los sábados."
                                >{{ old.notes ?? '' }}</textarea>
                            </div>

                        </div>

                        <div class="d-grid d-sm-flex justify-content-sm-end gap-2 mt-4">

                            <a class="btn btn-link order-2 order-sm-1" href="{{ path('administratives.index') }}">
                                Cancelar
                            </a>

                            <button
                                type="submit"
                                class="btn btn-primary order-1 order-sm-2 d-inline-flex align-items-center justify-content-center gap-2"
                                data-loading-label="Creando…"
                            >
                                <span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span>
                                <span class="label">Crear administrativo</span>
                            </button>

                        </div>
                    </div>
                </div>

            </form>
        </div>
    </div>
</div>
{% endblock %}
