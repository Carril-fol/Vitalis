{% extends 'base.html.twig' %}

{% block title %}Editar administrativo · Vitalis{% endblock %}

{% block body %}
    {% set user = form.vars.value.user %}

    <div class="container-fluid px-0">
        {% include '_components/_page_header.html.twig' with {
            title: 'Editar administrativo',
            subtitle: user.fullName ~ ' · DNI ' ~ user.dni ~ ' · ' ~ user.email,
            actions: [{path: path('administratives.index'), label: 'Volver a administrativos', icon: 'bi-arrow-left', class: 'btn btn-link px-0'}]
        } %}

        {% include '_components/_form_errors.html.twig' with {title: 'No se pudo guardar el legajo'} %}

        <div class="row">
            <div class="col-12 col-xl-8">
                {% include 'administratives/_form.html.twig' with {
                    is_edit: true,
                    submit_label: 'Guardar cambios',
                    loading_label: 'Guardando…'
                } %}
            </div>
        </div>
    </div>
{% endblock %}
