{% extends 'base.html.twig' %}

{% block title %}Centro Clinico Vitalis - Administrativos{% endblock %}

{% block body %}
<div class="container-fluid px-0">

    <!-- Encabezado de página -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
        <div>
            <h1 class="h3 mb-2">Administrativos</h1>
            <p class="vitalis-hint mb-0">
                El legajo administrativo de cada usuario: en qué sector trabaja y qué puesto ocupa.
            </p>
        </div>

        <a class="btn btn-primary d-inline-flex align-items-center gap-2 flex-shrink-0" href="{{ path('administratives.create') }}">
            <i class="bi bi-plus-lg" aria-hidden="true"></i>
            Nuevo administrativo
        </a>
    </div>

    {% if administratives is empty %}

        <!-- Estado vacío -->
        <div class="card">
            <div class="card-body text-center py-5">
                <i class="bi bi-person-badge text-primary display-5 d-block mb-3" aria-hidden="true"></i>
                <h2 class="h5 mb-2">Todavía no hay administrativos</h2>
                <p class="vitalis-hint mb-4">
                    Creá el primer legajo asignándoselo a un usuario existente.
                </p>
                <a class="btn btn-primary d-inline-flex align-items-center gap-2" href="{{ path('administratives.create') }}">
                    <i class="bi bi-plus-lg" aria-hidden="true"></i>
                    Crear el primero
                </a>
            </div>
        </div>

    {% else %}

        <!-- Listado -->
        <div class="card">
            <div class="card-header py-3">
                <h2 class="h6 mb-1">Listado de administrativos</h2>
                <p class="vitalis-hint mb-0">
                    {{ administratives|length == 1 ? '1 administrativo registrado' : administratives|length ~ ' administrativos registrados' }}
                </p>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">Usuario</th>
                            <th class="text-nowrap">Sector</th>
                            <th class="text-nowrap">Puesto</th>
                            <th class="w-100">Notas</th>
                            <th class="text-nowrap">Estado</th>
                            <th class="text-end pe-4 text-nowrap">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for administrative in administratives %}
                            {% set user = administrative.user %}
                            {% set active = user.isActive %}
                            {% set confirmar = active
                                ? 'Se va a dar de baja a "' ~ user.fullName ~ '". El legajo se conserva y se puede reactivar.'
                                : 'Se va a reactivar a "' ~ user.fullName ~ '".' %}

                            <tr>
                                <td class="ps-4">
                                    <span class="fw-semibold d-block">{{ user.fullName }}</span>
                                    <span class="vitalis-hint">DNI {{ user.dni }}</span>
                                </td>

                                <td class="text-nowrap">{{ administrative.sector }}</td>

                                <td class="text-nowrap">{{ user.role.name }}</td>

                                <td>
                                    {% if administrative.notes is null %}
                                        <span class="vitalis-hint">—</span>
                                    {% else %}
                                        {{ administrative.notes }}
                                    {% endif %}
                                </td>

                                <td class="text-nowrap">
                                    {% if active %}
                                        <span class="badge text-bg-success-subtle text-success-emphasis">Activo</span>
                                    {% else %}
                                        <span class="badge text-bg-secondary-subtle text-secondary-emphasis">Dado de baja</span>
                                    {% endif %}
                                </td>

                                <td class="text-end pe-4">
                                    <div class="d-inline-flex gap-2">

                                        <a class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1"
                                           href="{{ path('administratives.edit', {id: administrative.id}) }}">
                                            <i class="bi bi-pencil" aria-hidden="true"></i>
                                            <span class="d-none d-sm-inline">Editar</span>
                                        </a>

                                        <form method="post" class="d-inline"
                                              action="{{ path(active ? 'administratives.deactivate' : 'administratives.activate', {id: administrative.id}) }}"
                                              onsubmit="return confirm({{ confirmar|json_encode }});">
                                            <input type="hidden" name="_token" value="{{ csrf_token('status-administrative-' ~ administrative.id) }}">

                                            {% if active %}
                                                <button type="submit" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1">
                                                    <i class="bi bi-person-dash" aria-hidden="true"></i>
                                                    <span class="d-none d-sm-inline">Dar de baja</span>
                                                </button>
                                            {% else %}
                                                <button type="submit" class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-1">
                                                    <i class="bi bi-person-check" aria-hidden="true"></i>
                                                    <span class="d-none d-sm-inline">Reactivar</span>
                                                </button>
                                            {% endif %}
                                        </form>

                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>

    {% endif %}
</div>
{% endblock %}
