{% extends 'base.html.twig' %}

{% block title %}Administrativos · Vitalis{% endblock %}

{% block body %}
    <div class="container-fluid px-0">

        {% include '_components/_page_header.html.twig' with {
            title: 'Administrativos',
            subtitle: 'El legajo administrativo de cada usuario: en qué sector trabaja y qué puesto ocupa.',
            actions: [{path: path('administratives.create'), label: 'Nuevo administrativo', icon: 'bi-plus-lg', permission: 'create_administratives'}]
        } %}

        {% if administratives is empty %}

            {% include '_components/_empty_state.html.twig' with {
                icon: 'bi-person-badge',
                title: 'Todavía no hay administrativos',
                text: 'Creá el primer legajo asignándoselo a un usuario existente.',
                action: {path: path('administratives.create'), label: 'Crear el primero', permission: 'create_administratives'},
                denied_text: 'Esperá a que alguien con permiso para crear administrativos cargue el primero.'
            } %}

        {% else %}

            <div class="card">
                <div class="card-header py-3">
                    <h2 class="h6 mb-1">Listado de administrativos</h2>
                    <p class="vitalis-hint mb-0">
                        {{ administratives|length == 1 ? '1 administrativo registrado' : administratives|length ~ ' administrativos registrados' }}
                    </p>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4 w-100">Usuario</th>
                                <th class="text-nowrap">Sector</th>
                                <th class="text-nowrap">Puesto</th>
                                <th>Notas</th>
                                <th class="text-nowrap">Estado</th>
                                {% if is_granted('update_administratives') %}
                                    <th class="text-end pe-4 text-nowrap">Acciones</th>
                                {% endif %}
                            </tr>
                        </thead>
                        <tbody>
                            {% for administrative in administratives %}
                                {% set user = administrative.user %}
                                {% set active = user.isActive %}
                                {% set confirmar = active
                                    ? 'Se va a dar de baja a "' ~ user.fullName ~ '". El legajo se conserva y se puede reactivar.'
                                    : 'Se va a reactivar a "' ~ user.fullName ~ '".' %}

                                <tr>
                                    <td class="ps-4">
                                        <span class="fw-semibold d-block">{{ user.fullName }}</span>
                                        <span class="vitalis-hint">DNI {{ user.dni }}</span>
                                    </td>

                                    <td class="text-nowrap">{{ administrative.sector }}</td>

                                    <td class="text-nowrap">{{ user.role.name }}</td>

                                    <td>
                                        {% if administrative.notes is null %}
                                            <span class="vitalis-hint">—</span>
                                        {% else %}
                                            {{ administrative.notes }}
                                        {% endif %}
                                    </td>

                                    <td class="text-nowrap">
                                        {% include '_components/_status_badge.html.twig' with {active: active} %}
                                    </td>

                                    {% if is_granted('update_administratives') %}
                                        <td class="text-end pe-4">
                                            <div class="d-inline-flex gap-2">

                                                <a
                                                    class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1"
                                                    href="{{ path('administratives.edit', {id: administrative.id}) }}"
                                                    aria-label="Editar a {{ user.fullName }}"
                                                >
                                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                                    <span class="d-none d-sm-inline">Editar</span>
                                                </a>

                                                <form
                                                    method="post"
                                                    class="d-inline"
                                                    action="{{ path('administratives.status', {id : administrative.id, status : active ? 'deactivate' : 'activate'}) }}"
                                                    data-turbo-confirm="{{ confirmar }}"
                                                >
                                                    <input type="hidden" name="_token" value="{{ csrf_token('status-administrative-' ~ administrative.id) }}">

                                                    {% if active %}
                                                        <button type="submit" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1">
                                                            Desactivar
                                                        </button>
                                                    {% else %}
                                                        <button type="submit" class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-1">
                                                            Reactivar
                                                        </button>
                                                    {% endif %}
                                                </form>

                                            </div>
                                        </td>
                                    {% endif %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

        {% endif %}
    </div>
{% endblock %}
