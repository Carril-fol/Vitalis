{% extends 'base.html.twig' %}

{% block title %}Nuevo personal médico · Vitalis{% endblock %}

{% block body %}
    <div class="container-fluid px-0">
        {% include '_components/_page_header.html.twig' with {
            title: 'Nuevo personal médico',
            subtitle: 'Se crean la persona y su legajo en un solo paso. Incluye médicos, enfermeros, auxiliares y estudiantes internos.',
            actions: [{path: path('medicals.index'), label: 'Volver a personal médico', icon: 'bi-arrow-left', class: 'btn btn-link px-0'}]
        } %}

        {% include '_components/_form_errors.html.twig' with {title: 'No se pudo crear el registro'} %}

        <div class="row">
            <div class="col-12 col-xl-8">
                {% include 'medicals/_form.html.twig' with {
                    is_edit: false,
                    submit_label: 'Guardar personal médico',
                    loading_label: 'Creando…'
                } %}
            </div>
        </div>
    </div>
{% endblock %}
