{% extends 'base.html.twig' %}

{% block title %}Centro Clinico Vitalis - Editar Personal Médico{% endblock %}

{% block body %}
    <div class="container-fluid px-0">

        <!-- Encabezado -->
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
            <div>
                <h1 class="h3 fw-bold mb-1">Editar personal médico</h1>
                <p class="text-body-secondary mb-0">
                    Modificá los datos personales, el puesto y la especialidad.
                </p>
            </div>

            <a class="btn btn-link d-inline-flex align-items-center gap-2 flex-shrink-0 px-0" href="{{ path('medicals.index') }}">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                Volver a personal médico
            </a>
        </div>

        {% if not form.vars.valid %}
            <div class="alert alert-danger d-flex align-items-start gap-2" role="alert">
                <i class="bi bi-exclamation-circle-fill mt-1"></i>
                <div>
                    <strong>No se pudo guardar el legajo.</strong>
                    <div>Revisá los campos marcados en rojo abajo.</div>
                </div>
            </div>
        {% endif %}

        <!-- Formulario -->
        <div class="card border-0 shadow-sm">
            
            <!-- Datos del usuario -->
            <div class="card-header bg-body border-bottom py-3">
                <div class="d-flex align-items-center gap-3">

                    <div
                        class="bg-primary-subtle text-primary rounded-3 d-flex align-items-center justify-content-center flex-shrink-0"
                        style="width: 40px; height: 40px;"
                    >
                        <i class="bi bi-person-badge"></i>
                    </div>

                    <div>
                        {# 2. Leemos la info del Schema directamente desde el objeto vinculado al Form #}
                        <h2 class="h6 fw-semibold mb-1">{{ form.vars.value.user.firstName ~ ' ' ~ form.vars.value.user.lastName }}</h2>
                        <p class="small text-body-secondary mb-0">
                            DNI {{ form.vars.value.user.dni }} · {{ form.vars.value.user.email }}
                        </p>
                    </div>

                </div>
            </div>

            <div class="card-body p-4">
                {{ form_start(form, {'action': path('medicals.edit', {id: id})}) }}

                <h3 class="h6 text-uppercase fw-bold text-secondary mb-3">Datos Personales</h3>
                <div class="row g-3 mb-5">
                    {# Renderizamos el sub-formulario de usuario #}
                    {% for child in form.user %}
                        <div class="col-md-6">
                            {{ form_label(child, null, {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                            {{ form_widget(child, {
                                'attr': {
                                    'class': 'form-control' ~ (child.vars.errors|length > 0 ? ' is-invalid' : '')
                                }
                            }) }}
                            {% if child.vars.errors|length > 0 %}
                                <div class="invalid-feedback">{{ form_errors(child) }}</div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>

                <h3 class="h6 text-uppercase fw-bold text-secondary mb-3">Datos Profesionales</h3>
                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        {{ form_label(form.roleId, 'Puesto', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.roleId, {
                            'attr': {
                                'class': 'form-select' ~ (form.roleId.vars.errors|length > 0 ? ' is-invalid' : '')
                            }
                        }) }}
                        {% if form.roleId.vars.errors|length > 0 %}
                            <div class="invalid-feedback">{{ form_errors(form.roleId) }}</div>
                        {% endif %}
                        <div class="form-text">Es el rol de la persona: cambiarlo le cambia los permisos.</div>
                    </div>

                    <div class="col-md-6">
                        {{ form_label(form.specialityId, 'Especialidad', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.specialityId, {
                            'attr': {
                                'class': 'form-select' ~ (form.specialityId.vars.errors|length > 0 ? ' is-invalid' : '')
                            }
                        }) }}
                        {% if form.specialityId.vars.errors|length > 0 %}
                            <div class="invalid-feedback">{{ form_errors(form.specialityId) }}</div>
                        {% endif %}
                    </div>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <div class="form-check form-switch mt-4">
                            {{ form_widget(form.hasLicense, {
                                'attr': {'class': 'form-check-input'},
                                'label_attr': {'class': 'form-check-label fw-semibold'}
                            }) }}
                            {{ form_label(form.hasLicense, 'Posee Matrícula', {'label_attr': {'class': 'form-check-label fw-semibold'}}) }}
                        </div>
                    </div>

                    <div class="col-md-8">
                        {{ form_label(form.licenseNumber, 'Número de Matrícula', {'label_attr': {'class': 'form-label fw-semibold'}}) }}
                        {{ form_widget(form.licenseNumber, {
                            'attr': {
                                'class': 'form-control' ~ (form.licenseNumber.vars.errors|length > 0 ? ' is-invalid' : ''),
                                'placeholder': 'Ingrese la matrícula'
                            }
                        }) }}
                        {% if form.licenseNumber.vars.errors|length > 0 %}
                            <div class="invalid-feedback">{{ form_errors(form.licenseNumber) }}</div>
                        {% endif %}
                    </div>
                </div>

                {# 4. Renderizar campos ocultos necesarios #}
                {{ form_rest(form) }}

                <div class="d-flex flex-column flex-sm-row justify-content-end gap-2">
                    <a class="btn btn-outline-secondary" href="{{ path('medicals.index') }}">
                        Cancelar
                    </a>

                    <button type="submit" class="btn btn-primary d-inline-flex align-items-center justify-content-center gap-2">
                        <i class="bi bi-check-lg"></i>
                        Guardar cambios
                    </button>
                </div>

                {{ form_end(form) }}

            </div>

        </div>

    </div>
{% endblock %}
