{% extends 'base.html.twig' %}

{% form_theme scheduleForm 'bootstrap_5_layout.html.twig' %}
{% form_theme absenceForm 'bootstrap_5_layout.html.twig' %}

{% block title %}Horarios y ausencias · Vitalis{% endblock %}

{% block body %}
    {% set user = medic.user %}

    <div class="container-fluid px-0">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
            <div>
                <h1 class="h3 mb-2">Horarios y ausencias</h1>
                <p class="vitalis-hint mb-0">
                    {{ user.fullName() }} · {{ medic.speciality is null ? 'Sin especialidad' : medic.speciality.name() }}
                </p>
            </div>

            <a class="btn btn-link d-inline-flex align-items-center gap-2 flex-shrink-0 px-0" href="{{ path('medicals.index') }}">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                Volver a personal médico
            </a>
        </div>

        {% if medic.speciality is null %}
            <div class="alert alert-warning d-flex align-items-start gap-2 mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill mt-1 flex-shrink-0" aria-hidden="true"></i>
                <div>
                    <strong class="d-block">No tiene especialidad cargada</strong>
                    Aunque tenga horarios, no va a recibir turnos.
                    <a href="{{ path('medicals.edit', {id: medic.id}) }}">Editá el legajo</a> para asignársela.
                </div>
            </div>
        {% endif %}

        <div class="row g-4">

            <div class="col-12 col-xl-7">
                <div class="card">
                    <div class="card-header d-flex align-items-center gap-3 py-3">
                        <span class="vitalis-card-icon">
                            <i class="bi bi-calendar-week" aria-hidden="true"></i>
                        </span>
                        <div>
                            <h2 class="h6 mb-0">Horarios de atención</h2>
                            <p class="vitalis-hint mb-0">Cada franja se divide en turnos de la duración elegida.</p>
                        </div>
                    </div>

                    {% if schedules is empty %}
                        <div class="card-body">
                            <p class="vitalis-hint mb-0">Todavía no tiene horarios cargados.</p>
                        </div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th class="ps-4">Día</th>
                                        <th class="text-nowrap">Horario</th>
                                        <th class="w-100">Consultorio</th>
                                        <th class="text-nowrap">Turnos de</th>
                                        <th class="pe-4"><span class="visually-hidden">Acciones</span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for schedule in schedules %}
                                        {% set label = schedule.weekdayName ~ ' de ' ~ schedule.startTime|date('H:i') ~ ' a ' ~ schedule.endTime|date('H:i') %}
                                        <tr>
                                            <td class="ps-4 fw-semibold">{{ schedule.weekdayName }}</td>
                                            <td class="text-nowrap">{{ schedule.startTime|date('H:i') }} a {{ schedule.endTime|date('H:i') }}</td>
                                            <td>{{ schedule.consultingRoom.name }}</td>
                                            <td class="text-nowrap">{{ schedule.slotMinutes }} min</td>
                                            <td class="text-end pe-4">
                                                <form
                                                    method="post"
                                                    class="d-inline"
                                                    action="{{ path('medicals.schedule.delete', {id: schedule.id}) }}"
                                                    data-turbo-confirm="{{ 'Se va a quitar el horario del ' ~ label ~ '.' }}"
                                                >
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-schedule-' ~ schedule.id) }}">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Quitar horario del {{ label }}">
                                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}

                    <div class="card-body border-top">
                        <h3 class="h6 mb-3">Agregar horario</h3>

                        {{ form_start(scheduleForm, {attr: {novalidate: 'novalidate', 'data-vitalis-loading': true}}) }}
                        {{ form_errors(scheduleForm) }}

                        <div class="row">
                            <div class="col-12 col-sm-6">{{ form_row(scheduleForm.weekday) }}</div>
                            <div class="col-12 col-sm-6">
                                {% if scheduleForm.consultingRoom.vars.choices is empty %}
                                    {{ form_row(scheduleForm.consultingRoom, {
                                        help: 'No hay consultorios activos. <a href="' ~ path('consulting-rooms.create') ~ '">Creá uno</a> para poder asignarlo.',
                                        help_html: true
                                    }) }}
                                {% else %}
                                    {{ form_row(scheduleForm.consultingRoom) }}
                                {% endif %}
                            </div>
                            <div class="col-6 col-sm-4">{{ form_row(scheduleForm.startTime) }}</div>
                            <div class="col-6 col-sm-4">{{ form_row(scheduleForm.endTime) }}</div>
                            <div class="col-12 col-sm-4">{{ form_row(scheduleForm.slotMinutes) }}</div>
                        </div>

                        <div class="d-grid d-sm-flex justify-content-sm-end">
                            <button
                                type="submit"
                                class="btn btn-primary d-inline-flex align-items-center justify-content-center gap-2"
                                data-loading-label="Agregando…"
                            >
                                <span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span>
                                <span class="label">Agregar horario</span>
                            </button>
                        </div>

                        {{ form_end(scheduleForm) }}
                    </div>
                </div>
            </div>

            <div class="col-12 col-xl-5">
                <div class="card">
                    <div class="card-header d-flex align-items-center gap-3 py-3">
                        <span class="vitalis-card-icon">
                            <i class="bi bi-calendar-x" aria-hidden="true"></i>
                        </span>
                        <div>
                            <h2 class="h6 mb-0">Ausencias</h2>
                            <p class="vitalis-hint mb-0">
                                Vacaciones o licencias. Los feriados se cargan en <a href="{{ path('medicals.holidays') }}">Feriados</a>.
                            </p>
                        </div>
                    </div>

                    {% if absences is empty %}
                        <div class="card-body">
                            <p class="vitalis-hint mb-0">No tiene ausencias cargadas.</p>
                        </div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th class="ps-4">Período</th>
                                        <th class="w-100">Motivo</th>
                                        <th class="pe-4"><span class="visually-hidden">Acciones</span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for absence in absences %}
                                        <tr>
                                            <td class="ps-4 text-nowrap">
                                                <span class="d-block">{{ absence.startsAt|date('d/m/Y H:i') }}</span>
                                                <span class="vitalis-hint">a {{ absence.endsAt|date('d/m/Y H:i') }}</span>
                                            </td>
                                            <td>
                                                {% if absence.reason is empty %}
                                                    <span class="vitalis-hint">—</span>
                                                {% else %}
                                                    {{ absence.reason }}
                                                {% endif %}
                                            </td>
                                            <td class="text-end pe-4">
                                                <form
                                                    method="post"
                                                    class="d-inline"
                                                    action="{{ path('medicals.absence.delete', {id: absence.id}) }}"
                                                    data-turbo-confirm="Se va a quitar esta ausencia."
                                                >
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-absence-' ~ absence.id) }}">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Quitar ausencia del {{ absence.startsAt|date('d/m/Y') }}">
                                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}

                    <div class="card-body border-top">
                        <h3 class="h6 mb-3">Agregar ausencia</h3>

                        {{ form_start(absenceForm, {attr: {novalidate: 'novalidate', 'data-vitalis-loading': true}}) }}

                        <div class="row">
                            <div class="col-12 col-sm-6 col-xl-12">{{ form_row(absenceForm.startsAt) }}</div>
                            <div class="col-12 col-sm-6 col-xl-12">{{ form_row(absenceForm.endsAt) }}</div>
                            <div class="col-12">{{ form_row(absenceForm.reason, {attr: {placeholder: 'Ej. Vacaciones', maxlength: 150, autocomplete: 'off'}}) }}</div>
                        </div>

                        <div class="d-grid d-sm-flex justify-content-sm-end">
                            <button
                                type="submit"
                                class="btn btn-primary d-inline-flex align-items-center justify-content-center gap-2"
                                data-loading-label="Agregando…"
                            >
                                <span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span>
                                <span class="label">Agregar ausencia</span>
                            </button>
                        </div>

                        {{ form_end(absenceForm) }}
                    </div>
                </div>
            </div>

        </div>
    </div>
{% endblock %}
