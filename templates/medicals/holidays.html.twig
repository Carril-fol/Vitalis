{% extends 'base.html.twig' %}

{% form_theme form 'bootstrap_5_layout.html.twig' %}

{% block title %}Feriados · Vitalis{% endblock %}

{% block body %}
    <div class="container-fluid px-0">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
            <div>
                <h1 class="h3 mb-2">Feriados</h1>
                <p class="vitalis-hint mb-0">
                    Días en que no atiende nadie. No se dan turnos en esos períodos.
                </p>
            </div>

            <a class="btn btn-link d-inline-flex align-items-center gap-2 flex-shrink-0 px-0" href="{{ path('medicals.index') }}">
                <i class="bi bi-arrow-left" aria-hidden="true"></i>
                Volver a personal médico
            </a>
        </div>

        <div class="row">
            <div class="col-12 col-xl-8">
                <div class="card">
                    <div class="card-header d-flex align-items-center gap-3 py-3">
                        <span class="vitalis-card-icon">
                            <i class="bi bi-calendar-x" aria-hidden="true"></i>
                        </span>
                        <h2 class="h6 mb-0">Feriados cargados</h2>
                    </div>

                    {% if holidays is empty %}
                        <div class="card-body">
                            <p class="vitalis-hint mb-0">Todavía no hay feriados cargados.</p>
                        </div>
                    {% else %}
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th class="ps-4 text-nowrap">Desde</th>
                                        <th class="text-nowrap">Hasta</th>
                                        <th class="w-100">Motivo</th>
                                        <th class="pe-4"><span class="visually-hidden">Acciones</span></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for holiday in holidays %}
                                        <tr>
                                            <td class="ps-4 text-nowrap">{{ holiday.startsAt|date('d/m/Y H:i') }}</td>
                                            <td class="text-nowrap">{{ holiday.endsAt|date('d/m/Y H:i') }}</td>
                                            <td>
                                                {% if holiday.reason is empty %}
                                                    <span class="vitalis-hint">—</span>
                                                {% else %}
                                                    {{ holiday.reason }}
                                                {% endif %}
                                            </td>
                                            <td class="text-end pe-4">
                                                <form
                                                    method="post"
                                                    class="d-inline"
                                                    action="{{ path('medicals.absence.delete', {id: holiday.id}) }}"
                                                    onsubmit="return confirm({{ 'Se va a quitar este feriado.'|json_encode }});"
                                                >
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete-absence-' ~ holiday.id) }}">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" aria-label="Quitar feriado del {{ holiday.startsAt|date('d/m/Y') }}">
                                                        <i class="bi bi-trash" aria-hidden="true"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    {% endif %}

                    <div class="card-body border-top">
                        <h3 class="h6 mb-3">Agregar feriado</h3>

                        {{ form_start(form, {attr: {novalidate: 'novalidate', 'data-vitalis-loading': true}}) }}

                        <div class="row">
                            <div class="col-12 col-sm-6">{{ form_row(form.startsAt, {help: 'Para un día completo: 00:00.'}) }}</div>
                            <div class="col-12 col-sm-6">{{ form_row(form.endsAt, {help: 'Para un día completo: 23:59.'}) }}</div>
                            <div class="col-12">{{ form_row(form.reason, {attr: {placeholder: 'Ej. Día de la Independencia', maxlength: 150, autocomplete: 'off'}}) }}</div>
                        </div>

                        <div class="d-grid d-sm-flex justify-content-sm-end">
                            <button
                                type="submit"
                                class="btn btn-primary d-inline-flex align-items-center justify-content-center gap-2"
                                data-loading-label="Agregando…"
                            >
                                <span class="spinner-border spinner-border-sm d-none" aria-hidden="true"></span>
                                <span class="label">Agregar feriado</span>
                            </button>
                        </div>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
