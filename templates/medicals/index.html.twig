{% extends 'base.html.twig' %}

{% block title %}Personal médico · Vitalis{% endblock %}

{% block body %}
    <div class="container-fluid px-0">

        {% include '_components/_page_header.html.twig' with {
            title: 'Personal Médico',
            subtitle: 'Médicos, enfermeros, auxiliares y estudiantes internos del área médica.',
            actions: [
                {path: path('medicals.holidays'), label: 'Feriados', icon: 'bi-calendar-x', permission: 'update_medics', class: 'btn btn-outline-primary'},
                {path: path('medicals.create'), label: 'Nuevo personal médico', icon: 'bi-plus-lg', permission: 'create_medics'}
            ]
        } %}

        {% if medicalStaff is empty %}

            {% include '_components/_empty_state.html.twig' with {
                icon: 'bi-person-badge',
                title: 'Todavía no hay personal médico',
                text: 'Registrá al primer médico, enfermero, auxiliar o estudiante interno.',
                action: {path: path('medicals.create'), label: 'Registrar el primero', permission: 'create_medics'},
                denied_text: 'Esperá a que alguien con permiso para registrar personal médico lo haga.'
            } %}

        {% else %}

            <div class="card">
                <div class="card-header py-3">
                    <h2 class="h6 mb-1">Listado de personal médico</h2>
                    <p class="vitalis-hint mb-0">
                        {{ medicalStaff|length == 1 ? '1 registro' : medicalStaff|length ~ ' registros' }}
                    </p>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">Usuario</th>
                                <th class="text-nowrap">Puesto</th>
                                <th class="text-nowrap">Especialidad</th>
                                <th class="text-nowrap">Matrícula</th>
                                <th class="text-nowrap">Estado</th>
                                {% if is_granted('update_medics') %}
                                    <th class="text-end pe-4 text-nowrap">Acciones</th>
                                {% endif %}
                            </tr>
                        </thead>
                        <tbody>
                            {% for staff in medicalStaff %}
                                {% set user = staff.user %}
                                {% set active = user.isActive %}
                                {% set confirmar = active
                                    ? 'Se va a dar de baja a "' ~ user.fullName ~ '". El legajo se conserva y se puede reactivar.'
                                    : 'Se va a reactivar a "' ~ user.fullName ~ '".' %}

                                <tr>
                                    <td class="ps-4">
                                        <span class="fw-semibold d-block">{{ user.fullName }}</span>
                                        <span class="vitalis-hint">DNI {{ user.dni }}</span>
                                    </td>

                                    <td class="text-nowrap">{{ user.role.name }}</td>

                                    <td class="text-nowrap">
                                        {% if staff.speciality is null %}
                                            <span class="vitalis-hint">—</span>
                                        {% else %}
                                            {{ staff.speciality.name }}
                                        {% endif %}
                                    </td>

                                    <td class="text-nowrap">
                                        {% if staff.licenseNumber is null %}
                                            <span class="vitalis-hint">Sin matrícula</span>
                                        {% else %}
                                            {{ staff.licenseNumber }}
                                        {% endif %}
                                    </td>

                                    <td class="text-nowrap">
                                        {% include '_components/_status_badge.html.twig' with {active: active} %}
                                    </td>

                                    {% if is_granted('update_medics') %}
                                        <td class="text-end pe-4">
                                            <div class="d-inline-flex gap-2">

                                                <a
                                                    class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1"
                                                    href="{{ path('medicals.edit', {id: staff.id}) }}"
                                                    aria-label="Editar a {{ user.fullName }}"
                                                >
                                                    <i class="bi bi-pencil" aria-hidden="true"></i>
                                                    <span class="d-none d-sm-inline">Editar</span>
                                                </a>

                                                <a
                                                    class="btn btn-sm btn-outline-primary d-inline-flex align-items-center gap-1"
                                                    href="{{ path('medicals.schedule', {id: staff.id}) }}"
                                                    aria-label="Horarios de {{ user.fullName }}"
                                                >
                                                    <i class="bi bi-calendar-week" aria-hidden="true"></i>
                                                    <span class="d-none d-sm-inline">Horarios</span>
                                                </a>

                                                <form
                                                    method="post"
                                                    class="d-inline"
                                                    action="{{ path('medicals.status', {id: staff.id, status: active ? 'deactivate' : 'activate'}) }}"
                                                    data-turbo-confirm="{{ confirmar }}"
                                                >
                                                    <input type="hidden" name="_token" value="{{ csrf_token('status-medicalstaff-' ~ staff.id) }}">

                                                    {% if active %}
                                                        <button type="submit" class="btn btn-sm btn-outline-danger d-inline-flex align-items-center gap-1">
                                                            Desactivar
                                                        </button>
                                                    {% else %}
                                                        <button type="submit" class="btn btn-sm btn-outline-success d-inline-flex align-items-center gap-1">
                                                            Reactivar
                                                        </button>
                                                    {% endif %}
                                                </form>

                                            </div>
                                        </td>
                                    {% endif %}
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>

        {% endif %}
    </div>
{% endblock %}
