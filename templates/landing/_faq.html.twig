{% set faqs = [
    { q: '¿Qué tengo que llevar a la consulta?', a: 'Tu DNI, la credencial de tu obra social o prepaga y, si tenés, estudios previos relacionados con la consulta.' },
    { q: '¿Cómo cancelo o cambio un turno?', a: 'Llamanos o avisá en recepción, idealmente con 24 h de anticipación, así el horario le sirve a otro paciente.' },
    { q: '¿Cómo veo los resultados de mis estudios?', a: 'Retiralos en recepción con tu DNI. Los análisis de laboratorio están listos en 24 a 48 h.' },
    { q: '¿Atienden por obra social?', a: 'Sí, trabajamos con las principales obras sociales y prepagas. Podés ver el listado en la sección Coberturas.' },
] %}

<section id="faq" class="py-5 min-vh-100 d-flex flex-column justify-content-center" aria-labelledby="faq-title">
    <div class="container">
        <div class="row justify-content-center text-center mb-4 mb-lg-5">
            <div class="col-lg-8">
                <span class="badge rounded-pill text-bg-primary mb-3">
                    Preguntas frecuentes
                </span>
                <h2 id="faq-title" class="display-6 fw-bold mb-3">
                    Resolvé tus dudas
                </h2>
                <p class="lead text-body-secondary mb-0">
                    Respondemos las consultas más comunes sobre turnos, estudios y coberturas.
                </p>
            </div>
        </div>

        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div
                    class="accordion d-flex flex-column gap-3"
                    id="faq-list"
                    style="--bs-accordion-btn-focus-box-shadow: inset 0 0 0 .25rem rgba(var(--bs-primary-rgb), .25);"
                >
                    {% for faq in faqs %}
                        <div class="accordion-item border-0 shadow-sm rounded-4 overflow-hidden">
                            <h3 class="accordion-header">
                                <button
                                    class="accordion-button collapsed gap-3 p-4 fw-semibold"
                                    type="button"
                                    data-bs-toggle="collapse"
                                    data-bs-target="#faq-{{ loop.index }}"
                                    aria-expanded="false"
                                    aria-controls="faq-{{ loop.index }}"
                                >
                                    <i class="bi bi-question-circle text-primary fs-4 flex-shrink-0" aria-hidden="true"></i>
                                    {{ faq.q }}
                                </button>
                            </h3>
                            <div id="faq-{{ loop.index }}" class="accordion-collapse collapse" data-bs-parent="#faq-list">
                                <div class="accordion-body px-4 pb-4 pt-3 text-body-secondary">
                                    {{ faq.a }}
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    </div>
</section>
