{% set steps = [
    {
        title: 'Elegí la especialidad',
        text: 'Explorá nuestro staff médico y seleccioná la especialidad que necesitás atender.',
        icon: 'bi-search'
    },
    {
        title: 'Pedí tu turno',
        text: 'Llamanos o acercate a la recepción de lunes a viernes de 8 a 20 h o sábados de 8 a 13 h.',
        icon: 'bi-telephone'
    },
    {
        title: 'Asistí a tu consulta',
        text: 'Te enviaremos la confirmación. Recordá traer tu credencial y orden médica si corresponde.',
        icon: 'bi-check-circle'
    }
] %}

<section id="turnos" class="py-5 min-vh-100 d-flex flex-column justify-content-center" aria-labelledby="turnos-title">
    <div class="container">
        <header class="text-center mb-5">
            <span class="badge rounded-pill text-bg-primary mb-3">
                Proceso ágil
            </span>
            <h2 id="turnos-title" class="display-6 fw-bold mb-3">
                Cómo solicitar tu turno
            </h2>
            <p class="lead text-body-secondary mb-0">
                Obtené tu atención médica en tres simples pasos.
            </p>
        </header>

        <ol class="row row-cols-1 row-cols-md-3 g-4 list-unstyled mb-0">
            {% for step in steps %}
                <li class="col">
                    <article class="card h-100 border-0 shadow-sm">
                        <div class="card-body text-center p-4 p-lg-5">
                            <div
                                class="rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center mb-4"
                                style="width: 3.5rem; height: 3.5rem;"
                                aria-hidden="true"
                            >
                                <i class="bi {{ step.icon }} fs-4"></i>
                            </div>

                            <span class="d-block small fw-semibold text-primary text-uppercase mb-2">
                                Paso {{ loop.index }}
                            </span>

                            <h3 class="h5 fw-bold">{{ step.title }}</h3>
                            <p class="text-body-secondary mb-0">{{ step.text }}</p>
                        </div>
                    </article>
                </li>
            {% endfor %}
        </ol>

        <div class="text-center mt-5">
            <a href="#contacto" class="btn btn-primary btn-lg px-4">
                Quiero un turno
            </a>
        </div>
    </div>
</section>
