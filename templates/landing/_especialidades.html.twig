{% set specialities = [
    { name: 'Clínica médica', icon: 'bi-clipboard2-pulse' },
    { name: 'Pediatría', icon: 'bi-balloon-heart' },
    { name: 'Cardiología', icon: 'bi-heart-pulse' },
    { name: 'Ginecología', icon: 'bi-gender-female' },
    { name: 'Traumatología', icon: 'bi-person-walking' },
    { name: 'Dermatología', icon: 'bi-bandaid' },
    { name: 'Laboratorio', icon: 'bi-droplet-half' },
    { name: 'Diagnóstico por imágenes', icon: 'bi-lungs' },
] %}

<section id="especialidades" class="py-5 min-vh-100 d-flex flex-column justify-content-center" aria-labelledby="especialidades-title">
    <div class="container">
        <div class="row justify-content-center text-center mb-4 mb-lg-5">
            <div class="col-lg-8">
                <span class="badge rounded-pill text-bg-primary mb-3">
                    Especialidades y servicios
                </span>
                <h2 id="especialidades-title" class="display-6 fw-bold mb-3">
                    Encontrá la atención que necesitás
                </h2>
                <p class="lead text-body-secondary mb-0">
                    Contamos con profesionales y servicios para acompañarte en cada etapa.
                </p>
            </div>
        </div>

        <div class="row g-3 g-md-4">
            {% for speciality in specialities %}
                <div class="col-12 col-sm-6 col-lg-3">
                    <a
                        href="#contacto"
                        class="card h-100 border-0 shadow-sm text-decoration-none text-body rounded-4 p-3 p-lg-4"
                    >
                        <div class="d-flex align-items-center gap-3">
                            <span
                                class="d-inline-flex align-items-center justify-content-center flex-shrink-0
                                         bg-primary-subtle text-primary rounded-circle"
                                style="width: 3rem; height: 3rem;"
                            >
                                <i class="bi {{ speciality.icon }} fs-5" aria-hidden="true"></i>
                            </span>
                            <span class="fw-semibold">{{ speciality.name }}</span>
                        </div>
                    </a>
                </div>
            {% endfor %}
        </div>
    </div>
</section>
