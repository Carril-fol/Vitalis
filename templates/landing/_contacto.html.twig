<section id="contacto" class="py-5 min-vh-100 d-flex flex-column justify-content-center" aria-labelledby="contacto-title">
    <div class="container">
        <div class="row g-4 g-lg-5 align-items-stretch">
            <div class="col-lg-5">
                <div class="h-100 bg-white rounded-4 shadow-sm p-4 p-lg-5">
                    <span class="badge rounded-pill text-bg-primary mb-3">
                        Contacto y ubicación
                    </span>

                    <h2 id="contacto-title" class="h1 fw-bold mb-3">
                        Vení a visitarnos
                    </h2>
                    <p class="text-body-secondary mb-4">
                        Estamos para ayudarte. Encontrá nuestros datos de contacto,
                        horarios y opciones para llegar.
                    </p>

                    <address class="mb-0">
                        <ul class="list-group list-group-flush">
                            <li class="list-group-item px-0 d-flex gap-3">
                                <i class="bi bi-telephone text-primary fs-4" aria-hidden="true"></i>
                                <div>
                                    <strong class="d-block">Teléfono</strong>
                                    <a href="tel:+541100000000" class="link-primary">
                                        (011) 0000-0000
                                    </a>
                                </div>
                            </li>

                            <li class="list-group-item px-0 d-flex gap-3">
                                <i class="bi bi-geo-alt text-primary fs-4" aria-hidden="true"></i>
                                <div>
                                    <strong class="d-block">Dirección</strong>
                                    <span>Av. San Martín 2150, Buenos Aires</span>
                                </div>
                            </li>

                            <li class="list-group-item px-0 d-flex gap-3">
                                <i class="bi bi-clock text-primary fs-4" aria-hidden="true"></i>
                                <div>
                                    <strong class="d-block">Horarios</strong>
                                    <span>Lunes a viernes de 8 a 20 h<br>Sábados de 8 a 13 h</span>
                                </div>
                            </li>

                            <li class="list-group-item px-0 d-flex gap-3">
                                <i class="bi bi-bus-front text-primary fs-4" aria-hidden="true"></i>
                                <div>
                                    <strong class="d-block">Cómo llegar</strong>
                                    <span>Colectivos 24, 55 y 106. A 3 cuadras de la estación.</span>
                                </div>
                            </li>
                        </ul>
                    </address>

                    <a
                        href="https://www.google.com/maps/search/?api=1&query=Av.+San+Martín+2150,+Buenos+Aires"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-primary mt-4"
                    >
                        <i class="bi bi-map me-2" aria-hidden="true"></i>
                        Cómo llegar
                    </a>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="ratio ratio-4x3 h-100 rounded-4 overflow-hidden shadow-sm">
                    <iframe
                        src="https://www.google.com/maps?q=Buenos+Aires&output=embed"
                        title="Mapa de ubicación de la institución"
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        allowfullscreen
                    >
                    </iframe>
                </div>
            </div>
        </div>
    </div>
</section>
