{% set reasons = [
    {
        icon: 'bi-calendar-check',
        title: 'Turnos coordinados',
        text: 'Si necesitás varios estudios, los agendamos el mismo día para que vengas una sola vez.'
    },
    {
        icon: 'bi-people',
        title: 'Equipo interdisciplinario',
        text: 'Profesionales de distintas especialidades comparten tu historia clínica para ofrecerte una atención integral.'
    },
    {
        icon: 'bi-hospital',
        title: 'Guardia 24 hs',
        text: 'Atención de urgencias todos los días del año, con clínica médica y pediatría.'
    },
    {
        icon: 'bi-p-circle',
        title: 'Estacionamiento propio',
        text: 'Playa de estacionamiento sin cargo para pacientes durante la consulta.'
    }
] %}

<section id="por-que-elegirnos" class="py-5 min-vh-100 d-flex flex-column justify-content-center" aria-labelledby="por-que-elegirnos-title">
    <div class="container py-lg-4">
        <div class="row justify-content-center text-center mb-4 mb-lg-5">
            <div class="col-lg-8">
                <span class="badge rounded-pill text-bg-primary mb-3">
                    Por qué elegirnos
                </span>
                <h2 id="por-que-elegirnos-title" class="display-6 fw-bold mb-3">
                    Atención pensada para vos
                </h2>
                <p class="lead text-body-secondary mb-0">
                    Todo lo que necesitás para recibir una atención cercana, coordinada y de calidad.
                </p>
            </div>
        </div>

        <div class="row g-4">
            {% for reason in reasons %}
                <div class="col-12 col-sm-6 col-lg-3">
                    <article class="card h-100 border-0 shadow-sm rounded-4 text-center">
                        <div class="card-body d-flex flex-column align-items-center p-4">
                            <div class="d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-circle flex-shrink-0 mb-4" style="width: 4.5rem; height: 4.5rem;" aria-hidden="true">
                                <i class="bi {{ reason.icon }} fs-2"></i>
                            </div>

                            <h3 class="h5 fw-semibold mb-3">
                                {{ reason.title }}
                            </h3>

                            <p class="text-body-secondary mb-0">
                                {{ reason.text }}
                            </p>
                        </div>
                    </article>
                </div>
            {% endfor %}
        </div>
    </div>
</section>
