{% set testimonials = [
    {
        quote: 'La doctora se tomó el tiempo de explicarme todo sin apuro. Excelente atención desde el primer contacto.',
        name: 'Mariana G.',
        service: 'Clínica médica'
    },
    {
        quote: 'Siempre son puntuales y coordinan los estudios en el mismo lugar. Una experiencia muy cómoda para toda la familia.',
        name: 'Lucas F.',
        service: 'Pediatría'
    },
    {
        quote: 'En recepción resolvieron mis dudas sobre la cobertura en pocos minutos. Muy buena atención de principio a fin.',
        name: 'Norma R.',
        service: 'Cardiología'
    }
] %}

<section id="testimonios" class="py-5 min-vh-100 d-flex flex-column justify-content-center" aria-labelledby="testimonios-title">
    <div class="container">
        <div class="row justify-content-center text-center mb-4 mb-lg-5">
            <div class="col-lg-8">
                <span class="badge rounded-pill text-bg-primary mb-3">
                    Experiencias reales
                </span>
                <h2 id="testimonios-title" class="display-6 fw-bold mb-3">
                    Lo que dicen nuestros pacientes
                </h2>
                <p class="lead text-body-secondary mb-0">
                    La confianza de nuestros pacientes es parte fundamental de nuestra atención.
                </p>
            </div>
        </div>

        <div class="row g-4">
            {% for testimonial in testimonials %}
                <div class="col-12 col-md-6 col-lg-4">
                    <figure class="card h-100 border-0 shadow-sm rounded-4 mb-0">
                        <div class="card-body d-flex flex-column p-4 p-lg-5">
                            <div class="d-flex align-items-center gap-2 text-primary mb-4">
                                <i class="bi bi-quote fs-2" aria-hidden="true"></i>
                                <span class="small fw-semibold text-uppercase">
                                    Testimonio
                                </span>
                            </div>

                            <blockquote class="mb-4 flex-grow-1">
                                <p class="fs-5 mb-0">{{ testimonial.quote }}</p>
                            </blockquote>

                            <figcaption class="border-top pt-3">
                                <div class="fw-semibold">{{ testimonial.name }}</div>
                                <div class="small text-body-secondary">{{ testimonial.service }}</div>
                            </figcaption>
                        </div>
                    </figure>
                </div>
            {% endfor %}
        </div>
    </div>
</section>
