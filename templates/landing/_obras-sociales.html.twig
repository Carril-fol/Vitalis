{% if healthInsurances is not empty %}
    {% set logos = {
        'OSDE': 'osde',
        'Swiss Medical': 'swiss',
        'Sancor Salud': 'sancor',
        'PAMI': 'pami',
        'Galeno': 'galeno',
        'Medifé': 'medifé',
        'OSECAC': 'osecac'
    } %}

    <section id="obras-sociales" class="py-5 min-vh-100 d-flex flex-column justify-content-center" aria-labelledby="obras-sociales-title">
        <div class="container">
            <header class="text-center mb-4 mb-md-5">
                <span class="badge rounded-pill text-bg-primary mb-2">Coberturas</span>
                <h2 id="obras-sociales-title" class="h3 h2-md mb-2">
                    Obras sociales y prepagas
                </h2>
                <p class="lead text-body-secondary mb-0">
                    Trabajamos con las principales coberturas.
                </p>
            </header>

            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-3 g-lg-4 justify-content-center">
                {% for insurance in healthInsurances|filter(insurance => insurance.name != 'IOMA') %}
                    {% set name = insurance.name|default('Cobertura médica')|trim %}
                    {% set logo = logos[name]|default(null) %}

                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm">
                            <div class="card-body d-flex align-items-center justify-content-center text-center p-3 p-lg-4" style="min-height: 110px;">
                                {% if logo %}
                                    <img
                                        src="{{ asset('images/landing/obras-social/' ~ logo ~ '.webp') }}"
                                        alt="Logo de {{ name }}"
                                        class="img-fluid"
                                        width="160"
                                        height="48"
                                        loading="lazy"
                                        decoding="async"
                                    >
                                {% else %}
                                    <span class="fw-semibold text-body-secondary">
                                        {{ name }}
                                    </span>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>
{% endif %}
